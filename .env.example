# Environment Variables Example for Freelancer Dashboard
# Copy this file to .env and fill in your actual values
# IMPORTANT: .env is in .gitignore and should NEVER be committed

# ==========================================
# API CONFIGURATION
# ==========================================
# Development
VITE_API_BASE_URL=http://localhost:8081

# Production (replace with your actual API URL)
# VITE_API_BASE_URL=https://api.freelancer-os.com

# ==========================================
# APPLICATION MODE
# ==========================================
# dev or production
VITE_APP_ENV=dev
